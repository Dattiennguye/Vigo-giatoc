<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme nền tảng nhẹ: không dùng AppCompat để giảm dung lượng và thời gian khởi động -->
    <style name="Theme.NepNha" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ivory</item>
        <item name="android:statusBarColor">@color/ivory</item>
        <item name="android:navigationBarColor">@color/ivory</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- Màn khởi động: hiện nền kem + logo ngay, tránh màn trắng trên máy yếu -->
    <style name="Theme.NepNha.Splash">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
